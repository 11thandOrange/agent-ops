# Copy to .env (or set as real environment variables / deployment secrets).
PORT=8787

# The real upstream API this wiki's sandbox proxies "Try it" requests to.
# Matches wiki.config.yaml's backend.targetApiBaseUrl for this app.
TARGET_API_BASE_URL=https://your-store.myshopify.com

# Comma-separated list of origins allowed to call this proxy - the deployed
# wiki-site's own origin(s). Leave unset only for local development.
ALLOWED_ORIGINS=https://busybuddy.dev,http://localhost:5173
