      {
        "name": "e2e-tests-emulator",
        "runsOn": "ubuntu-latest",
        "steps": [
          {
            "name": "actions/checkout@v4",
            "detail": "uses: actions/checkout@v4"
          },
          {
            "name": "actions/setup-java@v4",
            "detail": "uses: actions/setup-java@v4"
          },
          {
            "name": "Enable KVM for hardware-accelerated emulator",
            "detail": "run: echo 'KERNEL==\"kvm\", GROUP=\"kvm\", MODE=\"0666\", OPTIONS+=\"static_node=kvm\"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules"
          },
          {
            "name": "AVD cache",
            "detail": "uses: actions/cache@v4"
          },
          {
            "name": "Create AVD snapshot for caching",
            "detail": "uses: reactivecircus/android-emulator-runner@v2"
          },
          {
            "name": "Write test runner script",
            "detail": "run: cat > \"$RUNNER_TEMP/run-emulator-tests.sh\" <<'SCRIPT_EOF'"
          },
          {
            "name": "Install Android SDK components",
            "detail": "run: export PATH=\"$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH\""
          },
          {
            "name": "Launch emulator and wait for full boot",
            "detail": "run: \"$ANDROID_HOME/emulator/emulator\" -port 5554 -avd test -no-window -gpu swiftshader_indirect -noaudio -no-boot-anim -came"
          },
          {
            "name": "Run tests",
            "detail": "run: RECORD_VIDEO=\"${{ inputs.record_video }}\" TEST_COMMAND=\"${{ inputs.test_command }}\" sh \"$RUNNER_TEMP/run-emulator-tests."
          },
          {
            "name": "Terminate emulator",
            "detail": "run: adb -s emulator-5554 emu kill || true"
          },
          {
            "name": "Checkout agent-ops scripts",
            "detail": "uses: actions/checkout@v4"
          },
          {
            "name": "Coverage manifest check",
            "detail": "run: cd .agent-ops-scripts/scripts && npm ci --omit=dev"
          },
          {
            "name": "Upload test results",
            "detail": "uses: actions/upload-artifact@v4"
          },
          {
            "name": "Upload video",
            "detail": "uses: actions/upload-artifact@v4"
          },
          {
            "name": "Post PR comment",
            "detail": "uses: actions/github-script@v7"
          }
        ]
      }
    ],
