# Copy to .env and fill in — never commit the real .env file.

# Shared-secret auth for /trigger, /webhook/github, /webhook/mcp (roadmap Phase 2, step 3)
ORCHESTRATOR_SHARED_SECRET=

# LiteLLM gateway
LITELLM_PROXY_URL=https://your-litellm-host/v1
LITELLM_VIRTUAL_KEY=

# GitHub App (replaces PAT — see docs/multi-pipeline-agent-strategy.md §7)
GH_APP_ID=
GH_APP_PRIVATE_KEY=
GH_WEBHOOK_SECRET=

# Allowlisted GitHub usernames whose @dev-agent comments are honored (§4.1)
ALLOWED_MENTION_AUTHORS=heyitschloe

PORT=3000
